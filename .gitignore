# Datos y resultados: conservar solo la estructura de carpetas
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/outputs/*
!/outputs/.gitkeep

# Entornos y cachés de Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Credenciales y configuración local
.env
.env.*
!.env.example

# Archivos del sistema
.DS_Store
Thumbs.db
Desktop.ini
